{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": { "type": "command", "command": "bash scripts/statusline.sh" },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(scripts/run-tests.sh:*)",
      "Bash(bash scripts/run-tests.sh:*)",
      "Bash(pre-commit run:*)",
      "Bash(sha256sum:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(bench drop-site:*)",
      "Bash(ssh:*)",
      "Read(**/site_config.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(bench:*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/guard-bash.sh" }] },
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/guard-protected.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/lint-file.sh" }] }
    ],
    "SessionStart": [
      { "matcher": "",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/session-start.sh" }] }
    ],
    "Stop": [
      { "matcher": "",
        "hooks": [{ "type": "command", "command": "bash scripts/hooks/brain-check.sh" }] }
    ]
  }
}
